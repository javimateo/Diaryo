{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "diaryo",
  "version": "0.1.0",
  "identifier": "app.diaryo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "diaryo",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Un diario infinito para dibujar, escribir y conectar ideas.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"]
      }
    }
  }
}
