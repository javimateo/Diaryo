{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "diaryo",
  "version": "0.2.0",
  "identifier": "app.diaryo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "diaryo",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://cloud.diaryo.javiermateo.dev",
        "object-src": "'none'",
        "base-uri": "'none'"
      },
      "devCsp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3N0M0NTU1MjEyQjA4MEUKUldRT0NDc2hWVVY4cHhkUGJrNVZ1QnZLbHFBc0dnS2V6bHFOZmhMVWtkUTdOQW9VakRIRFJLSncK",
      "endpoints": ["https://github.com/javimateo/Diaryo/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "license": "PolyForm-Noncommercial-1.0.0",
    "licenseFile": "../LICENSE",
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Un diario infinito para dibujar, escribir y conectar ideas.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"]
      }
    }
  }
}
