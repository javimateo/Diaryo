---
import '@fontsource-variable/caveat';
import '@fontsource-variable/lora';
import '@fontsource-variable/nunito-sans';
import '../styles/global.css';
import { homeHref, otherLang, texts, type Lang } from '../i18n';
import { SITE } from '../site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = texts(lang);
const other = otherLang(lang);
const home = homeHref(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const langs: Lang[] = ['es', 'en'];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // Light unless the visitor chose dark (before painting, so there is no flash).
      try {
        if (localStorage.getItem('diaryo-web:theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark';
        }
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header wrap">
      <a class="brand" href={home}><span class="dot" aria-hidden="true"></span>{SITE.name}</a>
      <nav class="links">
        <a href="#features">{t.nav.features}</a>
        <a href="#download">{t.nav.download}</a>
        <a href="#privacy">{t.nav.privacy}</a>
        <a href={SITE.repo}>{t.nav.source}</a>
      </nav>
      <div class="langs">
        {
          langs.map((code) =>
            code === lang ? (
              <span class="current" aria-current="page">
                {code.toUpperCase()}
              </span>
            ) : (
              <a href={homeHref(code)} hreflang={code} lang={code}>
                {code.toUpperCase()}
              </a>
            ),
          )
        }
      </div>
      <button
        class="theme"
        type="button"
        data-to-dark={t.nav.toDark}
        data-to-light={t.nav.toLight}
        aria-label={t.nav.toDark}
        title={t.nav.toDark}
      >
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path>
        </svg>
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
      <a class="button primary header-download" href="#download">
        <span class="wide">{t.nav.downloadWindows}</span>
        <span class="narrow">{t.nav.downloadShort}</span>
      </a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer wrap">
      <span class="name">{SITE.name}</span>
      <span class="made">{t.footer.made}</span>
      <a href={SITE.repo}>GitHub</a>
      <a href="#download">{t.nav.download}</a>
      <a href={other.href} hreflang={other.lang} lang={other.lang}>{t.footer.language}</a>
    </footer>
  </body>
</html>

<script>
  // The theme button: light ⇄ dark, remembered in this browser.
  const button = document.querySelector<HTMLButtonElement>('.theme');
  const root = document.documentElement;
  const label = () => {
    if (!button) return;
    const text = (root.dataset.theme === 'dark' ? button.dataset.toLight : button.dataset.toDark) ?? '';
    button.setAttribute('aria-label', text);
    button.title = text;
  };
  label();
  button?.addEventListener('click', () => {
    const dark = root.dataset.theme !== 'dark';
    if (dark) root.dataset.theme = 'dark';
    else delete root.dataset.theme;
    try {
      localStorage.setItem('diaryo-web:theme', dark ? 'dark' : 'light');
    } catch {
      // Without storage, the choice lasts until the page is left.
    }
    label();
  });
</script>

<style>
  .theme {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: var(--chip);
    color: var(--text);
    cursor: pointer;
  }

  .theme svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .theme .sun,
  :global([data-theme='dark']) .theme .moon {
    display: none;
  }

  :global([data-theme='dark']) .theme .sun {
    display: block;
  }

  .site-header {
    display: flex;
    align-items: center;
    gap: 32px;
    min-height: 76px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 22px;
    color: var(--text);
    text-decoration: none;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
  }

  .links {
    display: flex;
    gap: 28px;
    flex-grow: 1;
    font-size: 15px;
  }

  .links a {
    color: var(--text-soft);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--text);
  }

  .langs {
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    background: var(--chip);
    font-size: 13px;
    font-weight: 700;
  }

  .langs > * {
    padding: 5px 10px;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
  }

  .langs .current {
    background: var(--card);
    color: var(--text);
  }

  .header-download {
    min-height: 44px;
    padding: 10px 18px;
    font-size: 15px;
  }

  .narrow {
    display: none;
  }

  @media (max-width: 900px) {
    .links {
      display: none;
    }

    .site-header {
      gap: 12px;
      justify-content: space-between;
    }

    .brand {
      margin-right: auto;
    }

    .wide {
      display: none;
    }

    .narrow {
      display: inline;
    }
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    margin-top: 104px;
    padding-top: 40px;
    padding-bottom: 40px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    color: var(--muted);
  }

  .site-footer .name {
    font-weight: 700;
    color: var(--text);
  }

  .site-footer .made {
    flex-grow: 1;
  }

  .site-footer a {
    color: var(--text-soft);
  }
</style>
