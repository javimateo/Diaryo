---
import { texts, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

/**
 * The open diary of the hero, drawn with HTML so it scales with its box: every size is
 * in units of a 860 px wide scene (`--u`). H3 replaces it with the real engine.
 */
const { lang } = Astro.props;
const b = texts(lang).book;
const buildDate = new Intl.DateTimeFormat(lang, {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
}).format(new Date());
---

<div class="scene" role="img" aria-label={b.alt}>
  <div class="book" aria-hidden="true">
    <div class="page left">
      <p class="date">
        <span data-today>{buildDate}</span>
        <span class="today">{b.today}</span>
      </p>
      <p class="heading">{b.heading}</p>
      <ul class="tasks">
        {b.tasks.map((task, i) => <li class={i === b.doneTask ? 'done' : undefined}>{task}</li>)}
      </ul>
      <div class="note green page-note" style="--tilt: -3deg">{b.pageNote}</div>
    </div>
    <div class="page right">
      <div class="boxed">{b.boxed}</div>
    </div>
    <svg class="arrow" viewBox="0 0 780 540">
      <path d="M205 100 C 280 40, 400 60, 472 130"></path>
      <path d="M468 116.5 L472 130 L458.4 126.6"></path>
    </svg>
  </div>
  <div class="note desk-note" style="--tilt: -5deg" aria-hidden="true">{b.deskNote}</div>
  <div class="note pink shortcut-note" style="--tilt: 4deg" aria-hidden="true">
    {b.shortcutNote}
  </div>
</div>

<script>
  // The date of the build becomes today's, in the page's language.
  const lang = document.documentElement.lang;
  const today = new Intl.DateTimeFormat(lang, {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
  }).format(new Date());
  for (const el of document.querySelectorAll('[data-today]')) {
    el.textContent = today;
  }
</script>

<style>
  .scene {
    --u: calc(100cqw / 860);
    container-type: inline-size;
    position: relative;
    width: 100%;
    aspect-ratio: 860 / 640;
  }

  .book {
    position: absolute;
    left: calc(var(--u) * 40);
    top: 0;
    width: calc(var(--u) * 780);
    height: calc(var(--u) * 540);
    padding: calc(var(--u) * 12);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(var(--u) * 4);
    border-radius: calc(var(--u) * 14);
    background: var(--cover);
    box-shadow:
      0 calc(var(--u) * 30) calc(var(--u) * 60) rgba(40, 20, 5, 0.45),
      0 calc(var(--u) * 4) calc(var(--u) * 10) rgba(40, 20, 5, 0.3);
  }

  .page {
    position: relative;
    background-color: var(--paper);
    background-image: repeating-linear-gradient(
      180deg,
      transparent 0,
      transparent calc(var(--u) * 29),
      var(--paper-line) calc(var(--u) * 29),
      var(--paper-line) calc(var(--u) * 30)
    );
    font-family: var(--font-hand);
    color: var(--paper-ink);
  }

  .left {
    border-radius: calc(var(--u) * 4) calc(var(--u) * 2) calc(var(--u) * 2) calc(var(--u) * 4);
    padding: calc(var(--u) * 26) calc(var(--u) * 30) 0 calc(var(--u) * 44);
  }

  .right {
    border-radius: calc(var(--u) * 2) calc(var(--u) * 4) calc(var(--u) * 4) calc(var(--u) * 2);
  }

  /* The corner you pull to turn the page. */
  .right::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    width: calc(var(--u) * 34);
    height: calc(var(--u) * 34);
    background: linear-gradient(135deg, var(--paper-line) 0 50%, var(--cover) 50% 100%);
    border-top-left-radius: calc(var(--u) * 6);
  }

  .date,
  .heading,
  .tasks {
    margin: 0;
  }

  .date {
    margin: 0;
    font-size: calc(var(--u) * 30);
    line-height: 1;
  }

  .date [data-today] {
    display: inline-block;
  }

  .date [data-today]::first-letter {
    text-transform: uppercase;
  }

  .today {
    display: inline-block;
    margin-left: calc(var(--u) * 6);
    padding: calc(var(--u) * 2) calc(var(--u) * 8);
    border-radius: 999px;
    background: #d9684e;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: calc(var(--u) * 11);
    font-weight: 700;
    vertical-align: calc(var(--u) * 6);
  }

  .heading {
    margin-top: calc(var(--u) * 16);
    font-size: calc(var(--u) * 28);
    font-weight: 600;
  }

  .tasks {
    list-style: none;
    padding: 0;
    margin-top: calc(var(--u) * 48);
    display: flex;
    flex-direction: column;
    gap: calc(var(--u) * 4);
    font-size: calc(var(--u) * 24);
  }

  .tasks li::before {
    content: '';
    display: inline-block;
    width: calc(var(--u) * 14);
    height: calc(var(--u) * 14);
    margin-right: calc(var(--u) * 8);
    border: calc(var(--u) * 2) solid currentColor;
    border-radius: calc(var(--u) * 4);
    vertical-align: calc(var(--u) * -1);
  }

  .tasks .done {
    color: var(--paper-faint);
    text-decoration: line-through;
  }

  .tasks .done::before {
    background: currentColor;
  }

  .boxed {
    position: absolute;
    left: calc(var(--u) * 90);
    top: calc(var(--u) * 60);
    width: calc(var(--u) * 210);
    height: calc(var(--u) * 150);
    display: flex;
    align-items: center;
    justify-content: center;
    border: calc(var(--u) * 2.5) solid var(--paper-ink);
    padding: calc(var(--u) * 12);
    border-radius: calc(var(--u) * 8);
    font-size: calc(var(--u) * 30);
    line-height: 1.05;
    text-align: center;
    transform: rotate(-2deg);
  }

  .arrow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--pen-blue);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
  }

  .page-note {
    left: calc(var(--u) * 150);
    bottom: calc(var(--u) * 50);
    width: calc(var(--u) * 150);
    height: calc(var(--u) * 130);
    font-size: calc(var(--u) * 24);
  }

  .desk-note {
    left: 0;
    top: calc(var(--u) * 400);
    width: calc(var(--u) * 170);
    height: calc(var(--u) * 160);
    font-size: calc(var(--u) * 25);
  }

  .shortcut-note {
    left: calc(var(--u) * 690);
    top: calc(var(--u) * 470);
    width: calc(var(--u) * 160);
    height: calc(var(--u) * 150);
    font-size: calc(var(--u) * 25);
  }
</style>
