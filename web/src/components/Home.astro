---
import { fill, formatSize, legalHref, texts, type Lang } from '../i18n';
import { latestDownload } from '../release';
import { SITE } from '../site';
import DemoIsland from '../demo/DemoIsland';
import Book from './Book.astro';
import Cloud from './Cloud.astro';
import Download from './Download.astro';
import Features from './Features.astro';

interface Props {
  lang: Lang;
}

/** The home page: hero, features, the cloud, download, privacy and questions. */
const { lang } = Astro.props;
const t = texts(lang);
const download = await latestDownload();
const size = formatSize(download.sizeMB, lang);
const faq = t.faq.items.filter((item) => !('web' in item) || SITE.app);
---

<section class="hero" data-demo-host>
  <!-- Only on computers (see DESKTOP in DemoIsland); on a phone, the picture below. -->
  <DemoIsland client:media="(min-width: 961px) and (pointer: fine)" lang={lang} />
  <div class="hero-text">
    <span class="tagline">{t.hero.tagline}</span>
    <h1>{t.hero.title}</h1>
    <p class="subtitle">{t.hero.subtitle}</p>
    <div class="actions">
      <a
        class="button primary"
        href={download.url}
        data-installer
        data-umami-event="download"
        data-umami-event-place="hero"
      >
        <span>{t.hero.download}</span>
        <small>{fill(t.hero.downloadInfo, { version: download.version, size })}</small>
      </a>
      {
        SITE.app && (
          <a class="button chip" href={SITE.app} data-umami-event="open-web-app">
            {t.hero.tryWeb}
          </a>
        )
      }
    </div>
    <ul class="points">
      {t.hero.points.map((point) => <li>{point}</li>)}
    </ul>
  </div>
  <!-- The still picture (phones, and until the demo is ready); the demo puts the real
       book in its place. -->
  <div class="book-slot" data-demo-frame>
    <Book lang={lang} />
  </div>
</section>

<section class="strip wrap">
  {
    t.strip.map((item) => (
      <div>
        <h2>{item.title}</h2>
        <p>{item.text}</p>
      </div>
    ))
  }
</section>

<Features lang={lang} />

<Cloud lang={lang} />

<Download lang={lang} />

<section id="privacy" class="privacy wrap">
  <div>
    <span class="eyebrow">{t.privacy.eyebrow}</span>
    <h2 class="section-title">{t.privacy.title}</h2>
    <p>{t.privacy.text}</p>
    <p class="privacy-links">
      <a href={SITE.repo}>{t.privacy.source}</a>
      <a href={legalHref(lang, 'privacy')}>{t.privacy.policy}</a>
      <a href={legalHref(lang, 'terms')}>{t.privacy.terms}</a>
    </p>
  </div>
  <div class="faq">
    <h2 class="sr-only">{t.faq.title}</h2>
    {
      faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))
    }
  </div>
</section>

{
  SITE.app && (
    <section class="web-app wrap">
      <div class="band">
        <div>
          <h2>{t.webApp.title}</h2>
          <p>{t.webApp.text}</p>
        </div>
        <a class="button dark" href={SITE.app} data-umami-event="open-web-app">
          {t.webApp.button}
        </a>
      </div>
    </section>
  )
}

<style>
  .hero {
    position: relative;
    margin: 0 clamp(8px, 1.7vw, 24px);
    padding: clamp(40px, 5vw, 72px) clamp(20px, 4.5vw, 64px) clamp(40px, 5vw, 64px);
    display: grid;
    grid-template-columns: minmax(0, 470px) minmax(0, 1fr);
    align-items: center;
    gap: 40px;
    border-radius: 28px;
    overflow: hidden;
    color: var(--hero-text);
    /* Planks of the app's wood desk: joints every 132 px and an uneven horizontal grain. */
    background-color: var(--wood);
    background-image:
      repeating-linear-gradient(
        0deg,
        color-mix(in srgb, var(--wood-grain) 45%, transparent) 0 2px,
        transparent 2px 132px
      ),
      repeating-linear-gradient(
        0deg,
        color-mix(in srgb, var(--wood-grain) 14%, transparent) 0 1px,
        transparent 1px 7px
      ),
      repeating-linear-gradient(
        0deg,
        color-mix(in srgb, var(--wood-grain) 10%, transparent) 0 2px,
        transparent 2px 23px
      );
  }

  /* Over the demo, which fills the hero: nothing is drawn under the text. */
  .hero-text,
  .book-slot {
    position: relative;
    z-index: 1;
  }

  /* ─── With the live demo: the text on the desk, the real book where the picture was ─── */

  .hero[data-live] {
    /* Room at the bottom for the demo's toolbar, under the book. */
    padding-bottom: 88px;
  }

  .hero[data-live] .book-slot {
    visibility: hidden;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .tagline {
    align-self: flex-start;
    font-family: var(--font-hand);
    font-size: 30px;
    line-height: 1;
    transform: rotate(-3deg);
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  .subtitle {
    margin: 0;
    max-width: 430px;
    font-size: 19px;
    color: var(--hero-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .button.chip {
    background: var(--hero-chip);
    color: var(--hero-chip-text);
  }

  .points {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    font-weight: 700;
    color: var(--hero-soft);
  }

  /* The dot goes after each point, so a wrapped line never starts with one. */
  .points li:not(:last-child)::after {
    content: '·';
    margin-left: 18px;
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px 32px;
    padding-top: 48px;
    padding-bottom: 48px;
  }

  .strip h2 {
    margin: 0 0 4px;
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 700;
  }

  .strip p {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }

  .privacy {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 48px 64px;
    align-items: start;
    margin-top: 104px;
  }

  .privacy p {
    font-size: 17px;
    color: var(--text-soft);
  }

  .privacy-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-weight: 700;
  }

  .faq {
    border-radius: 18px;
    background: var(--card);
  }

  details + details {
    border-top: 1px solid var(--line-soft);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 44px;
    padding: 18px 26px;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    font-size: 22px;
    font-weight: 400;
    color: var(--muted);
    transition: transform 0.2s ease;
  }

  details[open] summary::after {
    transform: rotate(45deg);
  }

  .faq p {
    margin: -6px 0 0;
    padding: 0 26px 20px;
    font-size: 15px;
    color: var(--muted);
  }

  .web-app {
    margin-top: 104px;
  }

  .band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px 32px;
    padding: 40px 48px;
    border: 2px dashed var(--line);
    border-radius: 22px;
  }

  .band div {
    flex-grow: 1;
  }

  .band h2 {
    margin: 0 0 6px;
    font-size: 32px;
  }

  .band p {
    margin: 0;
    color: var(--muted);
  }

  .button.dark {
    background: var(--text);
    color: var(--ground);
  }
</style>
