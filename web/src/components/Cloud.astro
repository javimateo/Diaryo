---
import { texts, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

/**
 * The cloud: optional, end-to-end encrypted. The picture shows the same page on a laptop
 * and a phone, joined through the server, which only sees unreadable data.
 */
const { lang } = Astro.props;
const c = texts(lang).cloud;

/** A lock on the way to the server (the data leaves each device encrypted). */
const lock = (x: number, y: number) => `
  <g transform="translate(${x} ${y})">
    <circle r="13" class="lock-bg"></circle>
    <rect x="-5" y="-1" width="10" height="8" rx="1.5" class="lock-body"></rect>
    <path d="M-3.2 -1 v-3 a3.2 3.2 0 0 1 6.4 0 v3" class="lock-shackle"></path>
  </g>`;
---

<section id="cloud" class="cloud wrap">
  <div class="text">
    <span class="eyebrow">{c.eyebrow}</span>
    <h2 class="section-title">{c.title}</h2>
    <p class="lead">{c.text}</p>
    <div class="points">
      {
        c.points.map((point) => (
          <div class="point">
            <h3>{point.title}</h3>
            <p>{point.text}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="scene" aria-hidden="true">
    <svg viewBox="0 0 400 290">
      <path class="wire" d="M135 118 C135 70, 110 45, 140 45"></path>
      <path class="wire" d="M327 128 C327 70, 300 45, 260 45"></path>

      <rect x="140" y="20" width="120" height="50" rx="12" class="server"></rect>
      <text x="200" y="40" class="server-name">{c.server}</text>
      <text x="200" y="58" class="cipher">9f3a·c41e·77b0</text>

      <rect x="40" y="120" width="190" height="118" rx="10" class="bezel"></rect>
      <rect x="48" y="128" width="174" height="102" rx="4" class="desk"></rect>
      <rect x="24" y="238" width="222" height="10" rx="5" class="bezel base"></rect>
      <rect x="78" y="148" width="114" height="62" rx="4" class="cover"></rect>
      <rect x="82" y="152" width="52" height="54" class="paper"></rect>
      <rect x="136" y="152" width="52" height="54" class="paper"></rect>
      <path class="ink" d="M88 166 C94 160, 100 170, 108 164 S120 162, 126 166"></path>
      <path class="ink" d="M88 178 h30 M88 188 h22"></path>

      <rect x="290" y="128" width="74" height="132" rx="14" class="bezel"></rect>
      <rect x="296" y="136" width="62" height="116" rx="8" class="desk"></rect>
      <rect x="304" y="164" width="46" height="62" rx="3" class="cover"></rect>
      <rect x="307" y="167" width="40" height="56" class="paper"></rect>
      <path class="ink" d="M311 181 C316 175, 321 185, 327 179 S336 177, 341 181"></path>
      <path class="ink" d="M311 193 h24 M311 203 h18"></path>

      <Fragment set:html={lock(117, 70) + lock(312, 74)} />
    </svg>
    <span class="caption">{c.caption}</span>
  </div>
</section>

<style>
  .cloud {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 48px 64px;
    align-items: center;
    margin-top: 104px;
  }

  .lead {
    margin: 20px 0 24px;
    font-size: 17px;
    color: var(--text-soft);
  }

  .points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 14px;
  }

  .point {
    padding: 18px 20px;
    border-radius: 18px;
    background: var(--card);
  }

  .point h3 {
    margin: 0 0 4px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
  }

  .point p {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }

  .scene {
    --bezel: #2f2d29;
    position: relative;
    padding: 24px 24px 56px;
    border-radius: 22px;
    background: var(--card);
  }

  :global([data-theme='dark']) .scene {
    --bezel: #4a463f;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .server {
    fill: var(--chip);
  }

  .server-name {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-anchor: middle;
    fill: var(--muted);
  }

  .cipher {
    font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace;
    font-size: 11px;
    text-anchor: middle;
    fill: var(--muted);
  }

  .bezel {
    fill: var(--bezel);
  }

  .base {
    opacity: 0.85;
  }

  .desk {
    fill: var(--wood);
  }

  .cover {
    fill: var(--cover);
  }

  .paper {
    fill: var(--paper);
  }

  .ink {
    fill: none;
    stroke: var(--paper-ink);
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  .wire {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-dasharray: 6 6;
    animation: flow 1.6s linear infinite;
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -24;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wire {
      animation: none;
    }
  }

  .scene :global(.lock-bg) {
    fill: var(--accent);
  }

  .scene :global(.lock-body) {
    fill: var(--on-accent);
  }

  .scene :global(.lock-shackle) {
    fill: none;
    stroke: var(--on-accent);
    stroke-width: 1.6;
  }

  .caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18px;
    font-family: var(--font-hand);
    font-size: 24px;
    line-height: 1;
    text-align: center;
    color: var(--muted);
  }
</style>
